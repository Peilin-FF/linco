{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Linco 默认权限集",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "shell:default",
    "dialog:default",
    "dialog:allow-confirm",
    "dialog:allow-ask",
    "updater:default",
    "process:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "drag:default"
  ]
}
