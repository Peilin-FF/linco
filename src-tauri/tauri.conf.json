{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linco",
  "version": "0.2.1",
  "identifier": "ai.linco.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Linco",
        "width": 1280,
        "height": 832,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../vendor/HTML-VibeCoding/plugins": "plugins",
      "../vendor/HTML-VibeCoding/codex": "codex"
    },
    "macOS": {
      "hardenedRuntime": true
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDNzE5QTg3NDYyNjA2QTkKUldTcEJpWkdoNXB4bk1SYnY3WktCYVl4NjByMDhjeTNmZFo3dlpFRlNVVDlHdHh2MzY3S2JTTnkK",
      "endpoints": [
        "https://github.com/Peilin-FF/linco/releases/latest/download/latest.json"
      ]
    }
  }
}
