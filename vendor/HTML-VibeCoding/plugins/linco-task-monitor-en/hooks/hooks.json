{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/task-monitor-session-start.sh\"",
            "timeout": 10,
            "statusMessage": "Enabling background task monitor…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/task-monitor-pretooluse.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
