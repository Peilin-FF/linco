# Copy to ~/.config/linco-server/env, chmod 0600, then replace every example path.
# EnvironmentFile values are not shell-expanded: use absolute paths, never $HOME or ~.

LINCO_LISTEN=127.0.0.1:7337
LINCO_PUBLIC_URL=https://linco.example.com
LINCO_STATE_DIR=/home/alice/.local/state/linco-server
# Production traffic terminates TLS at Caddy; never expose the plaintext listener.
LINCO_ALLOW_INSECURE_LISTEN=false

# Semicolon-separated NAME=/absolute/path entries. Only listed roots are remotely accessible.
LINCO_WORKSPACES=main=/home/alice/projects/linco;client=/home/alice/projects/client-app

# Include the real installation directories for the Claude and Codex executables.
PATH=/home/alice/.local/bin:/home/alice/.cargo/bin:/home/alice/.npm-global/bin:/home/alice/.local/share/pnpm:/usr/local/bin:/usr/bin:/bin

LINCO_LOG_FORMAT=json
RUST_LOG=linco_server=info
