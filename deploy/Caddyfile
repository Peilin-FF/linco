{
	email ops@example.com
}

linco.example.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Caddy obtains and renews the public certificate. WebSocket upgrades are proxied
	# automatically; immediate flushing keeps terminal and approval traffic responsive.
	reverse_proxy 127.0.0.1:7337 {
		flush_interval -1
		transport http {
			dial_timeout 3s
			response_header_timeout 30s
			keepalive 30s
		}
	}

	log {
		output stdout
		format json
	}
}
